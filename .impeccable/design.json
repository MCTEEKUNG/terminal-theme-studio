  "narrative": {
    "northStar": "The Monochrome Glass Workspace",
    "overview": "The user-selected B design is a dark, black-and-white glass workspace. Translucent neutral panels, thin white boundaries and compact readable controls frame the terminal; authentic palette colors and user media remain expressive content. This explicit direction supersedes the earlier light archive expression.\n\nThis system applies only to Impeccable B. The original frontend-design A remains an independent dark slate and mint baseline. Sources are `src/impeccable.css`, shared primitives in `src/index.css`, and the unchanged component structure in `src/components/ImpeccableStudio.tsx`. The main interface has no comparison toolbar; shared loading/error screens and native terminal styling are outside this system.",
    "keyCharacteristics": [
      "Dark monochrome chrome with real colored terminal content.",
      "Translucent glass work areas with restrained neutral illumination.",
      "Settings left and terminal preview right; settings first on mobile."
    ],
    "rules": [
      {
        "name": "The Specimen Boundary Rule",
        "body": "Keep Web UI chrome achromatic; retain the true colors of terminal schemes, swatches and user media.",
        "section": "colors"
      },
      {
        "name": "The Product Type Rule",
        "body": "Use Hanken Grotesk for product UI; keep terminal font choice inside the preview and numeric readouts in the mono stack.",
        "section": "typography"
      },
      {
        "name": "The Glass Boundary Rule",
        "body": "Apply backdrop blur to the header and two work areas; preserve opaque fallbacks and legible controls.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do scope this system to B and retain A as an independent visual baseline.",
      "Do preserve the ordered background, red, green, yellow, blue, purple, cyan, foreground specimen ribbon.",
      "Do use labeled native controls and visible keyboard focus for product interactions.",
      "Do respect reduced motion and preserve textual saving, failure and connection states."
    ],
    "donts": [
      "Don't introduce chromatic accents into the Web UI chrome.",
      "Don't desaturate terminal palettes, swatches or user media to match the chrome.",
      "Don't apply B’s scoped tokens to A or change terminal preferences when switching designs.",
      "Don't reuse carried glyph icons as a pattern for new product controls."
    ]
  }
}
